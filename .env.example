# Copy to .env.local for local dev, and set the same vars in the Vercel project.

# Production origin — canonicals, JSON-LD, OG image URLs.
NEXT_PUBLIC_SITE_URL=https://ridoxstudio.com

# Microsoft Clarity project ID (Clarity → Settings → Overview).
# Leave unset locally to keep dev/preview traffic out of the production project.
NEXT_PUBLIC_CLARITY_PROJECT_ID=ybsg55yd3i

# Google Analytics 4 Measurement ID (GA4 Admin → Data streams → your web stream).
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XEYCGQJYN8

# --- Contact form: Zoho Mail SMTP (server-only, never exposed to the browser) ---
# Full mailbox address used to authenticate and send from.
ZOHO_SMTP_USER=hello@ridoxstudio.com
# App-specific password: Zoho Mail → Settings → Security → App passwords.
ZOHO_SMTP_PASSWORD=
# Region host: smtp.zoho.com (default) | smtp.zoho.eu | smtp.zoho.in | smtp.zoho.com.au
ZOHO_SMTP_HOST=smtp.zoho.com
# 465 = SSL (default), 587 = STARTTLS.
ZOHO_SMTP_PORT=465
# Where the internal "new enquiry" notification lands. Defaults to ZOHO_SMTP_USER.
CONTACT_NOTIFY_EMAIL=
